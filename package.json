{
  "name": "aimux",
  "private": true,
  "version": "0.2.29",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 127.0.0.1",
    "dev:desktop": "node scripts/tauri-dev.mjs",
    "dev:gateway": "powershell -ExecutionPolicy Bypass -File scripts/dev-gateway.ps1",
    "build": "vue-tsc -b && vite build --config vite.config.ts",
    "format": "prettier --write \"src/**/*.{ts,vue,scss}\" \"*.{json,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,scss}\" \"*.{json,ts}\"",
    "preview": "vite preview --config vite.config.ts --host 127.0.0.1",
    "tauri": "tauri"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "element-plus": "^2.11.5",
    "lucide-vue-next": "^0.577.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "prettier": "^3.9.6",
    "sass": "^1.90.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vue-tsc": "^3.0.6"
  }
}
