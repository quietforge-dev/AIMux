{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIMux",
  "version": "0.2.30",
  "identifier": "dev.quietforge.aimux",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1421",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AIMux",
        "width": 1280,
        "height": 820,
        "maximized": true,
        "minWidth": 1100,
        "minHeight": 680,
        "resizable": true,
        "minimizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/aimux.png", "icons/aimux.ico", "icons/aimux.icns"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg1OEZGREQ2NzQxRENGMkMKUldRc3p4MTAxdjJQaFo4a0ZyV3JHWTFYYVJTN00rYnF4aFlCYzB1UnQ0RjhLT2l3cFFBTnNGMGIK",
      "endpoints": ["https://github.com/quietforge-dev/AIMux/releases/latest/download/latest.json"]
    }
  }
}
